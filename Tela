import tkinter as tk
from tkinter.constants import DISABLED

PLACEHOLDER = "Digite o link da notícia:"
Voce="Você"
def analisar():
    link = entrada.get()

    # Previne que o seu placeholder ou vazios virem texto oficial
    if link == PLACEHOLDER or not link.strip():
        return

    # Destranca o widget, insere o texto e tranca de novo
    chat.config(state=tk.NORMAL, fg="#ffffff")
    # Insere o "Você:" aplicando a formatação visual da tag
    chat.insert(tk.END, "Você: ", "tag_voce")

    # Insere o resto da mensagem e a quebra de linha sem formatação extra (usa o padrão branco)
    chat.insert(tk.END, f"{link}\n\n")

    # Força a interface a rolar para a última linha inserida
    chat.see(tk.END)
    chat.config(state=tk.DISABLED)

    entrada.delete(0, tk.END)
    janela.focus_set()
    print("Link informado:", link)

    # Atualiza a Label com propriedades de formatação de texto em bloco

    # Limpa a entrada e força a devolução do foco para a raiz (disparando o FocusOut)
    entrada.delete(0, tk.END)
    janela.focus_set()


def apagar_texto(event):
    if entrada.get() == PLACEHOLDER:
        entrada.delete(0, tk.END)


def colocar_texto(event):
    if entrada.get() == "":
        entrada.insert(0, PLACEHOLDER)


# Inicialização do loop de interface
janela = tk.Tk()
janela.title("")
largura = 400
altura = 600

# Cálculo de geometria vetorial para centralização de janela
largura_tela = janela.winfo_screenwidth()
altura_tela = janela.winfo_screenheight()
x = (largura_tela - largura) // 2
y = (altura_tela - altura) // 2

janela.geometry(f"{largura}x{altura}+{x}+{y}")
janela.config(bg="#45484A")

# Área de exibição (agora com texto alinhado no topo esquerdo)
chat = tk.Text(janela, font=("Arial", 10), fg="#ffffff", cursor="arrow")
chat.place(width=370, height=530, x=15, y=15)
chat.tag_config("tag_voce", foreground="#000080")
chat.tag_config("tag_bot", foreground="#D75413")
chat.config(bg="#7a7a7a", state=DISABLED)

# Área de inserção
entrada = tk.Entry(janela)
entrada.insert(0, PLACEHOLDER)
entrada.place(width=310, height=30, x=15, y=555)
entrada.config(bg="#7a7a7a", fg="#ffff00")

# Botão de disparo de evento
botao = tk.Button(janela, text="Analisar", command=analisar)
botao.place(width=50, height=30, x=335, y=555)
botao.config(bg="#7a7a7a")

# Bindings de controle de estado (foco)
entrada.bind("<FocusIn>", apagar_texto)
entrada.bind("<FocusOut>", colocar_texto)

# Interceptação global de eventos do mouse para gerência de foco forçado
janela.bind("<Button-1>", lambda event: event.widget.focus_set())

janela.mainloop()
